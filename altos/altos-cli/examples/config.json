{
  "version": "1.0.0",
  "configVersion": 1,
  "defaultAgent": "agent-uuid-here",
  "providers": {
    "openai": {
      "type": "openai",
      "apiKey": "sk-...",
      "models": ["gpt-4o", "gpt-4o-mini", "gpt-4-turbo", "gpt-3.5-turbo"]
    },
    "anthropic": {
      "type": "anthropic",
      "apiKey": "sk-ant-...",
      "models": ["claude-3-5-sonnet-latest", "claude-3-opus-latest", "claude-3-haiku-20240307"]
    },
    "ollama": {
      "type": "ollama",
      "baseUrl": "http://localhost:11434",
      "models": ["llama3", "llama3:70b", "mistral", "codellama"]
    }
  },
  "channels": {
    "telegram": {
      "type": "telegram",
      "enabled": false,
      "config": {
        "botToken": "your-bot-token"
      }
    }
  },
  "agents": {
    "agent-uuid-here": {
      "id": "agent-uuid-here",
      "name": "my-agent",
      "description": "My first AI agent",
      "provider": "openai",
      "model": "gpt-4o",
      "systemPrompt": "You are a helpful AI assistant. Be concise and friendly.",
      "temperature": 0.7,
      "maxTokens": 2048,
      "createdAt": "2024-01-01T00:00:00.000Z",
      "updatedAt": "2024-01-01T00:00:00.000Z"
    }
  },
  "automations": [
    {
      "id": "automation-uuid-here",
      "name": "Daily Digest",
      "description": "Send a daily summary every morning",
      "trigger": {
        "type": "schedule",
        "config": {
          "schedule": "0 9 * * *",
          "timezone": "America/New_York"
        }
      },
      "actions": [
        {
          "type": "ai-complete",
          "config": {
            "prompt": "Summarize the latest AI news in 3 bullet points."
          }
        },
        {
          "type": "send-message",
          "config": {
            "channel": "telegram",
            "message": "{{ai-complete.output}}"
          }
        }
      ],
      "enabled": true,
      "createdAt": "2024-01-01T00:00:00.000Z",
      "updatedAt": "2024-01-01T00:00:00.000Z"
    }
  ],
  "meta": {
    "lastModified": "2024-01-01T00:00:00.000Z",
    "createdAt": "2024-01-01T00:00:00.000Z",
    "mode": "local-web"
  }
}
